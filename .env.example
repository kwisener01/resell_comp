# Copy this to .env and fill in your values
EBAY_APP_ID=your-ebay-app-id-here
ANTHROPIC_API_KEY=your-anthropic-key-here

# Set these after deploying — get values from eBay developer portal
EBAY_VERIFICATION_TOKEN=generate-a-random-string-here
EBAY_DELETION_ENDPOINT=https://your-app.railway.app/ebay/deletion
